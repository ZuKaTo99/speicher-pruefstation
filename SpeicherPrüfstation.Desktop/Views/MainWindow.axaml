<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SpeicherPrüfstation.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="SpeicherPrüfstation.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SpeicherPrüfstation.Desktop">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Border Margin="32"
            MaxWidth="680"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Spacing="16">

                <TextBlock Text="{Binding Greeting}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />

                <TextBlock Text="USB-Sticks und externe Laufwerke kontrolliert untersuchen"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Opacity="0.75" />

                <TextBlock Text="Externes USB-Speichergerät"
                           FontWeight="SemiBold"
                           Margin="0,12,0,0" />

                <ComboBox ItemsSource="{Binding StorageDevices}"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          IsEnabled="{Binding CanSelectDevice}"
                          HorizontalAlignment="Stretch"
                          MinHeight="42">

                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:StorageDeviceViewModel">
                            <StackPanel Margin="4">

                                <TextBlock Text="{Binding DevicePath}"
                                           FontWeight="SemiBold" />

                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">

                                    <TextBlock Text="{Binding DisplayName}"
                                               Opacity="0.75" />

                                    <TextBlock Text="·"
                                               Opacity="0.5" />

                                    <TextBlock Text="{Binding SizeText}"
                                               Opacity="0.75" />

                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Content="Geräte aktualisieren"
                        Command="{Binding RefreshDevicesCommand}"
                        HorizontalAlignment="Center"
                        Padding="18,8" />

                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsRefreshingDevices}"
                             Height="4" />

                <TextBlock Text="{Binding StatusMessage}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Opacity="0.75" />

                <ContentControl Content="{Binding SelectedDevice}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:StorageDeviceViewModel">

                            <Border Padding="16"
                                    Margin="0,8,0,0"
                                    BorderBrush="#505050"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                <StackPanel Spacing="12">

                                    <TextBlock Text="Gerätedetails"
                                               FontSize="18"
                                               FontWeight="SemiBold" />

                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="18"
                                          RowSpacing="8">

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="Gerät:"
                                                   Opacity="0.65" />

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="Gerätepfad:"
                                                   Opacity="0.65" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Text="{Binding DevicePath}" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="Kapazität:"
                                                   Opacity="0.65" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   Text="{Binding SizeText}" />

                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="0"
                                                   Text="Verbindung:"
                                                   Opacity="0.65" />

                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="1"
                                                   Text="{Binding TransportText}" />

                                        <TextBlock Grid.Row="4"
                                                   Grid.Column="0"
                                                   Text="Zugriff:"
                                                   Opacity="0.65" />

                                        <TextBlock Grid.Row="4"
                                                   Grid.Column="1"
                                                   Text="{Binding AccessText}" />

                                        <TextBlock Grid.Row="5"
                                                   Grid.Column="0"
                                                   Text="Partitionen:"
                                                   Opacity="0.65" />

                                        <TextBlock Grid.Row="5"
                                                   Grid.Column="1"
                                                   Text="{Binding VolumeCountText}" />

                                    </Grid>

                                    <Border Height="1"
                                            Margin="0,4"
                                            Background="#505050" />

                                    <TextBlock Text="Erkannte Partitionen"
                                               FontSize="16"
                                               FontWeight="SemiBold" />

                                    <ItemsControl ItemsSource="{Binding Volumes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StorageVolumeViewModel">

                                                <Border Padding="12"
                                                        Margin="0,0,0,8"
                                                        BorderBrush="#3F3F3F"
                                                        BorderThickness="1"
                                                        CornerRadius="6">

                                                    <StackPanel Spacing="8">

                                                        <TextBlock Text="{Binding DevicePath}"
                                                                   FontWeight="SemiBold" />

                                                        <Grid ColumnDefinitions="Auto,*"
                                                              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                                              ColumnSpacing="18"
                                                              RowSpacing="6">

                                                            <TextBlock Grid.Row="0"
                                                                       Grid.Column="0"
                                                                       Text="Größe:"
                                                                       Opacity="0.65" />

                                                            <TextBlock Grid.Row="0"
                                                                       Grid.Column="1"
                                                                       Text="{Binding SizeText}" />

                                                            <TextBlock Grid.Row="1"
                                                                       Grid.Column="0"
                                                                       Text="Dateisystem:"
                                                                       Opacity="0.65" />

                                                            <TextBlock Grid.Row="1"
                                                                       Grid.Column="1"
                                                                       Text="{Binding FileSystemText}" />

                                                            <TextBlock Grid.Row="2"
                                                                       Grid.Column="0"
                                                                       Text="Bezeichnung:"
                                                                       Opacity="0.65" />

                                                            <TextBlock Grid.Row="2"
                                                                       Grid.Column="1"
                                                                       Text="{Binding LabelText}"
                                                                       TextWrapping="Wrap" />

                                                            <TextBlock Grid.Row="3"
                                                                       Grid.Column="0"
                                                                       Text="Eingehängt:"
                                                                       Opacity="0.65" />

                                                            <TextBlock Grid.Row="3"
                                                                       Grid.Column="1"
                                                                       Text="{Binding MountPointText}"
                                                                       TextWrapping="Wrap" />

                                                            <TextBlock Grid.Row="4"
                                                                       Grid.Column="0"
                                                                       Text="Zugriff:"
                                                                       Opacity="0.65" />

                                                            <TextBlock Grid.Row="4"
                                                                       Grid.Column="1"
                                                                       Text="{Binding AccessText}" />

                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <Button Content="SMART-Hardwarestatus prüfen"
                        Command="{Binding CheckSmartHealthCommand}"
                        HorizontalAlignment="Center"
                        Padding="18,8"
                        Margin="0,4,0,0" />

                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsCheckingSmartHealth}"
                             Height="4" />

                <ContentControl Content="{Binding SmartHealth}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:SmartHealthResultViewModel">

                            <Border Padding="16"
                                    BorderBrush="#505050"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                <StackPanel Spacing="12">

                                    <TextBlock Text="SMART-Hardwarestatus"
                                               FontSize="18"
                                               FontWeight="SemiBold" />

                                    <TextBlock Text="{Binding HealthText}"
                                               FontSize="20"
                                               FontWeight="SemiBold" />

                                    <TextBlock Text="{Binding SummaryText}"
                                               TextWrapping="Wrap"
                                               Opacity="0.8" />

                                    <Grid ColumnDefinitions="Auto,*"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="18"
                                          RowSpacing="8">

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Text="Modell:"
                                                   Opacity="0.65" />

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   Text="{Binding ModelText}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Text="Seriennummer:"
                                                   Opacity="0.65" />

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Text="{Binding SerialNumberText}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Text="Kapazität:"
                                                   Opacity="0.65" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   Text="{Binding CapacityText}" />

                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="0"
                                                   Text="Blockgröße:"
                                                   Opacity="0.65" />

                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="1"
                                                   Text="{Binding LogicalBlockSizeText}" />

                                        <TextBlock Grid.Row="4"
                                                   Grid.Column="0"
                                                   Text="Schnittstelle:"
                                                   Opacity="0.65" />

                                        <TextBlock Grid.Row="4"
                                                   Grid.Column="1"
                                                   Text="{Binding DeviceTypeText}" />

                                        <TextBlock Grid.Row="5"
                                                   Grid.Column="0"
                                                   Text="SMART verfügbar:"
                                                   Opacity="0.65" />

                                        <TextBlock Grid.Row="5"
                                                   Grid.Column="1"
                                                   Text="{Binding SmartAvailableText}" />

                                        <TextBlock Grid.Row="6"
                                                   Grid.Column="0"
                                                   Text="SMART aktiviert:"
                                                   Opacity="0.65" />

                                        <TextBlock Grid.Row="6"
                                                   Grid.Column="1"
                                                   Text="{Binding SmartEnabledText}" />

                                        <TextBlock Grid.Row="7"
                                                   Grid.Column="0"
                                                   Text="Temperatur:"
                                                   Opacity="0.65" />

                                        <TextBlock Grid.Row="7"
                                                   Grid.Column="1"
                                                   Text="{Binding TemperatureText}" />

                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <Border Padding="16"
                        Margin="0,8,0,0"
                        BorderBrush="#505050"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Text="ClamAV-Virenscan"
                                   FontSize="18"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="Lesemodus: Die Dateien auf dem USB-Gerät werden nur gelesen. Bereits eingehängte Partitionen müssen zuvor regulär ausgehängt sein."
                                   TextWrapping="Wrap"
                                   Opacity="0.8" />

                        <WrapPanel>
                            <Button Content="Virenscan starten"
                                    Command="{Binding StartVirusScanCommand}"
                                    Padding="16,8"
                                    Margin="0,0,8,8" />
                            <Button Content="Virenscan abbrechen"
                                    Command="{Binding StartVirusScanCancelCommand}"
                                    Padding="16,8"
                                    Margin="0,0,0,8" />
                        </WrapPanel>

                        <ProgressBar IsIndeterminate="True"
                                     IsVisible="{Binding IsVirusWorkActive}"
                                     Height="4" />

                        <TextBlock Text="{Binding VirusScanStateText}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding VirusScanSummary}"
                                   TextWrapping="Wrap" />

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="16"
                              RowSpacing="12">
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Geprüfte Dateien" Opacity="0.65" />
                                <TextBlock Text="{Binding ScannedFileCount}" FontSize="20" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="Funde" Opacity="0.65" />
                                <TextBlock Text="{Binding VirusFindingCount}" FontSize="20" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Fehler" Opacity="0.65" />
                                <TextBlock Text="{Binding VirusErrorCount}" FontSize="20" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="Warnungen" Opacity="0.65" />
                                <TextBlock Text="{Binding VirusWarningCount}" FontSize="20" />
                            </StackPanel>
                        </Grid>

                        <Border IsVisible="{Binding HasPendingCleanup}"
                                Padding="12"
                                BorderBrush="#C89126"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Das Aushängen ist noch nicht bestätigt. Andere Zugriffe auf das Gerät schließen und erneut versuchen."
                                           TextWrapping="Wrap" />
                                <Button Content="Aushängen erneut versuchen"
                                        Command="{Binding RetryCleanupCommand}"
                                        Padding="12,8" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Fundliste" FontWeight="SemiBold" />
                        <TextBox Text="{Binding VirusFindingsText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="70"
                                 MaxHeight="220" />

                        <TextBlock Text="Warnungen und Fehler" FontWeight="SemiBold" />
                        <TextBox Text="{Binding VirusMessagesText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="70"
                                 MaxHeight="240" />

                        <TextBlock Text="Während des Scans kann die Dateianzahl verzögert erscheinen. Ein Virenscanner kann keine vollständige Sicherheit garantieren."
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Opacity="0.65" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
